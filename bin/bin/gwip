#!/usr/bin/perl -w

use strict;
use Getopt::Long;

my $help;
my $type = 'wip';

sub help() {
        print STDOUT <<'HELP';

gwip - create a timestamped work-in-progress commit

USAGE:
    >> gwip [options] [message]

Options:
    --type TYPE  (-t) Set the commit type (default: wip)
    --help       (-h) Show this message

EXAMPLES:
    >> gwip
    >> gwip "my message"
    >> gwip --type feat "my message"

HELP
}

if (!GetOptions(
        'type|t=s' => \$type,
        'help|h' => \$help
)) {
        help();
        exit 1;
}

if (defined $help || (defined $ARGV[0] && $ARGV[0] eq 'help')) {
        help();
        exit 0;
}

my $timestamp = `shortdate`;
chomp $timestamp;
my $message = @ARGV
    ? "$type: " . join(' ', @ARGV) . " $timestamp"
    : "$type: $timestamp";

my $status = system('commit', '--stage', '--message', $message);
if ($status == -1) {
    die "Unable to run commit: $!\n";
}
if ($status & 127) {
    die "commit terminated by signal " . ($status & 127) . "\n";
}
exit($status >> 8);
